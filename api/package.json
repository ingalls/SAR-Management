        "@openaddresses/batch-schema": "^10.28.1",
        "@sinclair/typebox": "^0.34.52",
        "@slack/web-api": "^8.1.1",
        "@supercharge/promise-pool": "^3.3.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "api2pdf": "^2.1.0",
        "bcrypt": "^6.0.0",
        "busboy": "^1.6.0",
        "chart.js": "^4.5.1",
        "connect-history-api-fallback": "^2.0.0",
        "cors": "^2.8.6",
        "csv-stringify": "^6.8.3",
        "discord.js": "^14.27.0",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "drizzle-typebox": "^0.3.3",
        "express": "^5.2.1",
