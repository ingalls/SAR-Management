# Copied to deploy.d/.env by ./deploy on the first run. deploy.d/.env holds
# secrets and is gitignored - never commit it.
#
# Every key below is exported into the API container; DOMAIN and POSTGRES are
# also read by docker-compose.yml itself.

# Public DNS name of this server. Managed by ./deploy.
DOMAIN=

# Required: connection string for the external database (e.g. a DigitalOcean
# Managed Database). It must accept TLS connections and allow
# CREATE EXTENSION postgis, which the first migration runs.
#   POSTGRES=postgres://user:password@host:25060/sar
POSTGRES=

# --- Application --------------------------------------------------------------

# Anything other than "test" enables production behaviour
StackName=prod

# Secret used to sign user sessions (JWTs). Generated by ./deploy.
# Changing it logs every user out.
SigningSecret=

# Required: transactional email
MailGun=

# Required: DigitalOcean Spaces / S3 credentials and buckets for uploads
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_BUCKET_PUBLIC=
AWS_DEFAULT_REGION=us-east-1

# Optional: PDF conversion via api2pdf.com (mission reports)
API2PDF=
