# Copied to deploy.d/.env by ./deploy on the first run. deploy.d/.env holds
# secrets and is gitignored - never commit it.
#
# Every key below is exported into the API container; DOMAIN, POSTGRES and
# POSTGRES_PASSWORD are also read by docker-compose.yml itself.

# Public DNS name of this server. Managed by ./deploy.
DOMAIN=

# Password for the bundled Postgres container. Generated by ./deploy.
POSTGRES_PASSWORD=

# Leave empty to use the bundled Postgres container. To use an external
# database instead (e.g. a DigitalOcean Managed Database, which must accept
# TLS connections) set the full connection string:
#   POSTGRES=postgres://user:password@host:25060/sar
POSTGRES=

# --- Application --------------------------------------------------------------

# Anything other than "test" enables production behaviour
StackName=prod

# Secret used to sign user sessions (JWTs). Generated by ./deploy.
# Changing it logs every user out.
SigningSecret=

# Required: transactional email
MailGun=

# Required: DigitalOcean Spaces / S3 credentials and buckets for uploads
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_BUCKET_PUBLIC=
AWS_DEFAULT_REGION=us-east-1

# Optional: PDF conversion via api2pdf.com (mission reports)
API2PDF=
